# Server
PORT=4175
HOST=0.0.0.0

# Dashboard protection. If empty the dashboard is open (not recommended for public VPS).
# The dashboard can also store a new password in SQLite; this value stays a recovery password.
ADMIN_PASSWORD=

# Optional: stable secret for dashboard sessions. Generated and stored in data/ when empty.
SESSION_SECRET=

# Optional: bootstrap API key for /v1 endpoints (created on first boot if provided).
API_KEY=

# Optional: import a cookie export automatically on boot (JSON, Netscape, or raw name=value header).
COOKIE_FILE=
COOKIE_PROFILE_NAME=Main account

# Defaults
DEFAULT_MODEL=nano-banana-pro
DEFAULT_RATIO=1:1
ACCOUNT_CONCURRENCY=1
MAX_ATTEMPTS=3
JOB_TIMEOUT_MS=300000
RETENTION_DAYS=30
RATE_LIMIT_RPM=60

# Background refresh of accounts, credits and expiry every N minutes. 0 disables it.
AUTO_SYNC_MINUTES=15

# Optional public URL used in generated links (e.g. https://images.example.com)
PUBLIC_BASE_URL=

# SQLite database, encryption keys and session secret (Docker: /app/data)
DATA_DIR=./data

# info | warn | error
LOG_LEVEL=info
